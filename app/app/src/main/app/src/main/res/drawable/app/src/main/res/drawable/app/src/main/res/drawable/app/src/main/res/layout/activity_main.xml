<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gta6_sunset"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gta6_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewStatusAccent"
                android:layout_width="5dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:background="#FF4FD8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="ДИАГНОСТИКА // РЕНО СЦЕНИК II"
                android:textColor="#00F5D4"
                android:textSize="16sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:text="НЕ В СЕТИ"
                android:textColor="#FF4FD8"
                android:textSize="11sp"
                android:textStyle="bold|italic" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="1.6 16V K4M • ТЕЛЕМЕТРИЯ ELM327 OBD-II"
            android:textColor="#FFB3EC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="АКБ: --.-В  |  ОБОРОТЫ: ----  |  ОЖ: ---°C"
            android:textColor="#FFF0F5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_gta6_neon"
        android:text="1. ПОДКЛЮЧИТЬ ELM327"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold|italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReadDtc"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_gta6_neon"
            android:text="2. СЧИТАТЬ ОШИБКИ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold|italic" />

        <Button
            android:id="@+id/btnClearDtc"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_gta6_neon"
            android:text="3. СБРОСИТЬ ОШИБКИ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStartLive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_gta6_neon"
            android:text="4. АВТООПРОС СТАРТ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold|italic" />

        <Button
            android:id="@+id/btnStopLive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_gta6_neon"
            android:enabled="false"
            android:text="5. АВТООПРОС СТОП"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSaveLog"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.35"
            android:background="@drawable/btn_gta6_neon"
            android:text="6. СОХРАНИТЬ (.TXT)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold|italic" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_gta6_neon"
            android:text="7. ОЧИСТИТЬ ЛОГ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDemoMode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_gta6_neon"
        android:text="8. ТЕСТ БЕЗ ELM327 (ДЕМО)"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold|italic" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gta6_panel"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="[СИСТЕМА ГОТОВА] Ожидание подключения к OBD-II...\n"
            android:textColor="#00F5D4"
            android:textSize="13sp" />
    </ScrollView>
</LinearLayout>
